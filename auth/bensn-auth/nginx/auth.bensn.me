server {
    listen 80;
    server_name auth.bensn.me;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name auth.bensn.me;

    ssl_certificate     /etc/letsencrypt/live/auth.bensn.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.bensn.me/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Auth-Endpunkte direkt zum Auth-Service
    location /auth/ {
        proxy_pass         http://127.0.0.1:5003;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-Proto https;
        # Cookies durchreichen
        proxy_pass_header  Set-Cookie;
    }

    location / {
        return 302 https://bensn.me;
    }
}
