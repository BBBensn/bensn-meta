server {
    server_name pdf.bensn.me;

    location / {
        proxy_pass http://localhost:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/pdf.bensn.me/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pdf.bensn.me/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = pdf.bensn.me) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name pdf.bensn.me;
    return 404; # managed by Certbot


}